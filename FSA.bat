:: ======================================
:: Security Check - DEMO ONLY
:: ======================================

:DemoRoutine
title Security Check
color BE

echo Launching Security Check...
timeout /t 1 >nul

echo Verifying system components...
timeout /t 1 >nul

for /L %%i in (1,1,6) do (
    set /a percent=!random! %% 100
    echo Component %%i ........ !percent!%%
    timeout /t 1 >nul
)

timeout /t 2 >nul

for %%A in (
    Power
    Audio
    Storage
    NVMe
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

timeout /t 1 >nul

for %%S in (
    HTTP
    DNS
    POP3
) do (
    set /a state=!random! %% 2
    if !state! EQU 0 (
        echo %%S ........ ONLINE
    ) else (
        echo %%S ........ STANDBY
    )
)

echo Preview complete.
pause
goto :eof

:skipDemo
:: ======================================
:: END OF SECURITY CHECK BLOCK
:: ======================================

goto :skipScan

:: ======================================
:: Performance Scan - DEMO ONLY
:: ======================================

:ScanRoutine
title Performance Scan
color 0B

echo Launching Performance Scan...
timeout /t 1 >nul

echo Verifying system components...
timeout /t 1 >nul

for /L %%i in (1,1,4) do (
    set /a percent=!random! %% 100
    echo Component %%i ........ !percent!%%
    timeout /t 1 >nul
)

echo.
echo Collecting statistics...
timeout /t 2 >nul

for %%A in (
    Memory
    Power
    USB
    CPU
) do (
    set /a score=!random! %% 100
    echo %%A Status: !score!%%
)

echo Check finished.
pause
goto :eof

